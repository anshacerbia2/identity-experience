# Copy to .env beside this file for scripts/dev-local.ps1. .env is git-ignored; never commit it.
# Every variable is described in TDD-identity-experience-001 §Configuration.

# The BFF's private key, made on this machine by `node scripts/new-client-key.mjs`. The client has
# no secret: it authenticates with this key by signed JWT, and the server holds only the public half.
# Leave empty for the default, keys/identity-experience-bff.pem. Never copy this file anywhere else.
IDENTITY_EXPERIENCE_CLIENT_KEY_FILE=

# A database the session store may create its schema in. The script adds the search path.
IDENTITY_EXPERIENCE_DEV_DATABASE_URL=postgres://organization:organization@localhost:5432/postgres

# Where identity-control listens on this machine, for /api/*. Sign-in works without it; the
# proxied calls answer 503 until it runs.
IDENTITY_CONTROL_BASE_URL=http://127.0.0.1:8097

# The development kernel's public issuer, exactly as its discovery document states it.
IDENTITY_EXPERIENCE_ISSUER=https://gqr8l4jz-8080.asse.devtunnels.ms/realms/scnehaux

# Generated by the script on its first run and written here, so sessions survive a restart.
IDENTITY_EXPERIENCE_SESSION_KEY=
