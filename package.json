{
  "name": "identity-experience",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @identity-experience/admin dev",
    "dev:developer": "pnpm --filter @identity-experience/developer dev",
    "dev:bff": "pnpm --filter @identity-experience/bff dev",
    "build": "pnpm --filter @identity-experience/admin build && pnpm --filter @identity-experience/developer build && pnpm --filter @identity-experience/bff build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm -r --if-present lint:styles && pnpm -r --if-present lint:boundaries",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
